include /atom/badge/badge.mixin.pug

include input-search.mixin.pug

+ippon-input-search({ placeholder: 'Placeholder' })
+ippon-input-search({ value: 'Value' })
+ippon-input-search({ placeholder: 'Placeholder' })
  +ippon-badge({ iconRight: { name: 'close', clickable: true } }) 2
+ippon-input-search({ variant: 'error', placeholder: 'Placeholder' })
+ippon-input-search({ variant: 'success', placeholder: 'Placeholder', value: 'Value' })
+ippon-input-search({ placeholder: 'Placeholder', readonly: true, value: 'Value' })
+ippon-input-search({ placeholder: 'Placeholder', disabled: true })

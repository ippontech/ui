include checkbox.mixin.pug

+ippon-checkbox({ id: 'checkbox-unchecked' }) Unchecked
+ippon-checkbox({ id: 'checkbox-checked', checked: true }) Checked
+ippon-checkbox({ id: 'checkbox-error', variant: 'error' }) Error
+ippon-checkbox({ id: 'checkbox-disabled', disabled: true }) Disabled
+ippon-checkbox({ id: 'checkbox-disabled-checked', checked: true, disabled: true }) Disabled checked

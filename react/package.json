{
  "name": "@ippon-ui/react",
  "description": "Ippon UI React Component Library",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ippontech/ui.git",
    "directory": "react"
  },
  "author": "Ippon Technologies",
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 4230",
    "build": "pnpm run build:lib && pnpm run build:storybook",
    "build:lib": "tsc -b && vite build",
    "build:storybook": "storybook build",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "@ippon-ui/icons": "~0.0.2",
    "@ippon-ui/styles": "~0.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@eslint/js": "10.0.1",
    "@ippon-ui/icons": "workspace:*",
    "@ippon-ui/styles": "workspace:*",
    "@rolldown/plugin-babel": "0.2.3",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.13.3",
    "@types/prismjs": "1.26.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-istanbul": "4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "eslint-plugin-storybook": "10.5.10",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prismjs": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "10.5.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.11"
  }
}
